[resource]
script = ExtResource("3_qsdwc")
id = &"abomination_immolate"
display_name = "Immolate"
description = "Sets the Abomination alight. Every enemy within 90 units burns for as long as it is held, taking 3% of the Abomination's own max health as fire damage each second. Costs 1 Rage to light and 15 Rage a second to hold; once Rage runs dry the fire keeps burning on the Abomination itself, starting at 1% of its max health a second and rising by 1% every second it keeps draining."
