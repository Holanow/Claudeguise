[gd_resource type="Resource" script_class="ActionDef" format=3]

[ext_resource type="Script" path="res://Scripts/Core/AbilityEffect.gd" id="1_ab8fx"]
[ext_resource type="Script" path="res://Scripts/Core/Effects/HitEffect.gd" id="2_hitfx"]
[ext_resource type="Script" path="res://Scripts/Core/Effects/PullEffect.gd" id="3_pullfx"]
[ext_resource type="Script" path="res://Scripts/Core/ActionDef.gd" id="4_sbadef"]
[ext_resource type="Script" path="res://Scripts/Core/ActionTargeting.gd" id="5_sbtgt"]
[ext_resource type="Resource" path="res://Scripts/Content/VFX/sellsword_crescent.tres" id="vfx_sellsword_crescent"]
[ext_resource type="Script" path="res://Scripts/Core/Effects/StepEffect.gd" id="6_stepfx"]
[ext_resource type="Script" path="res://Scripts/Core/ActionBeat.gd" id="7_beat"]
[ext_resource type="Resource" path="res://Scripts/Content/VFX/sellsword_crescent_opener.tres" id="vfx_opener"]
[ext_resource type="Resource" path="res://Scripts/Content/VFX/sellsword_crescent_finisher.tres" id="vfx_finisher"]

[sub_resource type="Resource" id="Resource_crhit"]
script = ExtResource("2_hitfx")
damage_type = 7
power_scale = 3.25

[sub_resource type="Resource" id="Resource_crpul"]
script = ExtResource("3_pullfx")
distance = -35.0

[sub_resource type="Resource" id="Resource_crtg1"]
script = ExtResource("5_sbtgt")
range_units = 55.0
splash_radius = 150.0
arc_degrees = 65.0

[sub_resource type="Resource" id="Resource_step1"]
script = ExtResource("6_stepfx")
distance = -40.0

[sub_resource type="Resource" id="Resource_hit1"]
script = ExtResource("2_hitfx")
damage_type = 7
power_scale = 0.8

[sub_resource type="Resource" id="Resource_tgt1"]
script = ExtResource("5_sbtgt")
range_units = 70.0
splash_radius = 70.0
arc_degrees = 45.0

[sub_resource type="Resource" id="Resource_beat1"]
script = ExtResource("7_beat")
delay_ticks = 0
targeting = SubResource("Resource_tgt1")
effects = Array[ExtResource("1_ab8fx")]([SubResource("Resource_step1"), SubResource("Resource_hit1")])
vfx = ExtResource("vfx_opener")

[sub_resource type="Resource" id="Resource_beat2"]
script = ExtResource("7_beat")
delay_ticks = 9
effects = Array[ExtResource("1_ab8fx")]([SubResource("Resource_crhit"), SubResource("Resource_crpul")])

[sub_resource type="Resource" id="Resource_hit3"]
script = ExtResource("2_hitfx")
damage_type = 7
power_scale = 4.0

[sub_resource type="Resource" id="Resource_tgt3"]
script = ExtResource("5_sbtgt")
range_units = 200.0
splash_radius = 200.0
arc_degrees = 80.0

[sub_resource type="Resource" id="Resource_beat3"]
script = ExtResource("7_beat")
delay_ticks = 18
targeting = SubResource("Resource_tgt3")
effects = Array[ExtResource("1_ab8fx")]([SubResource("Resource_hit3")])
vfx = ExtResource("vfx_finisher")

[resource]
script = ExtResource("4_sbadef")
id = &"sellsword_crescent"
display_name = "Crescent"
description = "A three-part combo: a small reversed opening slash with a step back, the original wide arc, and an even larger reversed finisher. Moderate cooldown."
wind_up_ticks = 11
recover_ticks = 16
cooldown_ticks = 58
targeting = SubResource("Resource_crtg1")
effects = Array[ExtResource("1_ab8fx")]([SubResource("Resource_crhit"), SubResource("Resource_crpul")])
vfx = ExtResource("vfx_sellsword_crescent")
beats = Array[ExtResource("7_beat")]([SubResource("Resource_beat1"), SubResource("Resource_beat2"), SubResource("Resource_beat3")])
