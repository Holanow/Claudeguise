[resource]
script = ExtResource("3_48xmg")
id = &"warden_axe"
display_name = "Executioner's Axe"
description = "A three-part combo at up to 55 units, after a 0.7-second wind-up. Each part swings a little further than the last and each has a 35% chance to open a bleed, so a victim who stands through all three bleeds three times over."
wind_up_ticks = 20
recover_ticks = 22
