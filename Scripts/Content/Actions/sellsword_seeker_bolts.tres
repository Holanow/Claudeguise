[gd_resource type="Resource" script_class="ActionDef" format=3]

[ext_resource type="Script" path="res://Scripts/Core/ActionDelivery.gd" id="1_swkdl"]
[ext_resource type="Script" path="res://Scripts/Core/AbilityEffect.gd" id="2_ab8fx"]
[ext_resource type="Script" path="res://Scripts/Core/Effects/HitEffect.gd" id="3_hitfx"]
[ext_resource type="Script" path="res://Scripts/Core/ActionDef.gd" id="4_sbadef"]
[ext_resource type="Script" path="res://Scripts/Core/ActionTargeting.gd" id="5_sbtgt"]
[ext_resource type="Resource" path="res://Scripts/Content/VFX/sellsword_seeker_bolts.tres" id="vfx_sellsword_seeker_bolts"]

[sub_resource type="Resource" id="Resource_sbdlv"]
script = ExtResource("1_swkdl")
speed = 13.0
count = 2
separate_targets = true
spread_degrees = 16.0
homing_strength = 7.0
trail = true

[sub_resource type="Resource" id="Resource_sbhit"]
script = ExtResource("3_hitfx")
power_scale = 1.65

[sub_resource type="Resource" id="Resource_sbtg1"]
script = ExtResource("5_sbtgt")
range_units = 240.0
requires_line_of_sight = true

[resource]
script = ExtResource("4_sbadef")
id = &"sellsword_seeker_bolts"
display_name = "Seeker Bolts"
description = "Two homing bolts at up to 240 units, each striking for less than one alone."
wind_up_ticks = 8
recover_ticks = 10
cooldown_ticks = 24
targeting = SubResource("Resource_sbtg1")
delivery = SubResource("Resource_sbdlv")
effects = Array[ExtResource("2_ab8fx")]([SubResource("Resource_sbhit")])
vfx = ExtResource("vfx_sellsword_seeker_bolts")
