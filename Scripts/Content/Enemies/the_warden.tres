[ext_resource type="Script" path="res://Scripts/Plans/Blocks/UseActionBlock.gd" id="9_wduse"]
[ext_resource type="Script" path="res://Scripts/Plans/Blocks/CloseAndActBlock.gd" id="6_wdcaa"]
