[sub_resource type="Resource" id="Resource_wdpln0"]
script = ExtResource("2_wdpln")
id = &"warden_chain_row"
display_name = "Chain the enemy farthest away and haul them in"
condition = SubResource("Resource_wdalw1")
blocks = Array[ExtResource("7_wdblk")]([SubResource("Resource_wdtfe1"), SubResource("Resource_wduse1")])

[sub_resource type="Resource" id="Resource_wdpln1"]
script = ExtResource("2_wdpln")
id = &"warden_attack_row"
display_name = "Otherwise walk to the nearest enemy and axe them"
condition = SubResource("Resource_wdalw2")
blocks = Array[ExtResource("7_wdblk")]([SubResource("Resource_wdtna1"), SubResource("Resource_wduse2"), SubResource("Resource_wdcaa1")])

[resource]
script = ExtResource("1_tmy0m")
id = &"the_warden"
display_name = "The Warden"
hp_max = 1000
radius = 33.0
move_speed = 1.4
attack_power = {
0: 58
}
damage_reduction = 0.05
actions = Array[StringName]([&"warden_axe", &"warden_chain_toss"])
display_tags = Array[String](["Melee", "Ranged", "Boss"])
plans = Array[ExtResource("2_wdpln")]([SubResource("Resource_wdpln0"), SubResource("Resource_wdpln1")])
