[ext_resource type="Resource" path="res://Scripts/Content/Actions/warden_chain_toss.tres" id="act_warden_chain_toss"]
[ext_resource type="Resource" path="res://Scripts/Content/Actions/warden_axe.tres" id="act_warden_axe"]

[sub_resource type="Resource" id="Resource_wdalw1"]
script = ExtResource("3_wdalw")

[sub_resource type="Resource" id="Resource_wdalw2"]
script = ExtResource("3_wdalw")

[sub_resource type="Resource" id="Resource_wdtfe1"]
script = ExtResource("8_wdtfe")

[sub_resource type="Resource" id="Resource_wduse1"]
script = ExtResource("9_wduse")
action = ExtResource("act_warden_chain_toss")

[sub_resource type="Resource" id="Resource_wdtna1"]
script = ExtResource("4_wdtna")

[sub_resource type="Resource" id="Resource_wduse2"]
